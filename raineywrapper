#!/bin/sh
# Runs the builder inside its virtualenv, creating it on first use.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
VENV="$HERE/builder/.venv"
if [ ! -x "$VENV/bin/python" ]; then
  echo "[raineywrapper] Setting up Python environment (first run only)..."
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q -r "$HERE/builder/requirements.txt"
fi
exec "$VENV/bin/python" "$HERE/builder/raineywrapper.py" "$@"
